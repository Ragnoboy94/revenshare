# Public site URL (used in metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3041
# Demo subdomain host only (no scheme). Local: demo.localhost → http://demo.localhost:3041/mebel39/
NEXT_PUBLIC_DEMO_HOST=demo.localhost
# Runtime override for the server (wins over the value above). Production: demo.revenshare.ru
# DEMO_HOST=demo.revenshare.ru
# Folder with separate demo git projects (default: demo-workspace)
DEMO_WORKSPACE=demo-workspace

# Secret admin URL: https://your.domain/a/<ADMIN_PATH>
# Generate: node -e "console.log('rs-'+require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PATH=
# Password on that page (min 6 chars)
ADMIN_PASSWORD=
# Optional extra secret for cookie signing (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Telegram lead notifications (optional — leads always saved to data/leads.json)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public Telegram link in footer (optional)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/

# Support chat: local knowledge from content/support-bot/*.md — no API keys

# --- Outreach / Checko ---
# Local: path to kit profile (cookies). Prod: outside app tree.
# OUTREACH_CHECKO_PROFILE_DIR=C:\Users\...\revershare\checko-portable-kit\profile\checko-pw-profile
OUTREACH_CHECKO_DELAY_MS=1800
OUTREACH_CHECKO_ENRICH_DELAY_MS=9000
OUTREACH_CHECKO_ENRICH_PER_JOB=12
# OUTREACH_CHECKO_HEADED=1
# OUTREACH_MAIL_TEST=1
# Prod VPS: residential/HTTP proxy for Checko (localhost ignores OUTREACH_FSA_PROXY)
# OUTREACH_CHECKO_PROXY=http://user:pass@host:8000
# OUTREACH_FSA_PROXY=http://user:pass@host:8000


# SMTP for admin mailing (Рассылка). Mail.ru Biz: smtp.mail.ru:465
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=info@revenshare.ru
SMTP_PASS=
SMTP_FROM=info@revenshare.ru
# Redirect all outreach mail to one inbox (testing)
# OUTREACH_MAIL_OVERRIDE_TO=you@mail.ru
# Operator inbox for «Тестовое письмо» (defaults to OVERRIDE_TO)
# OUTREACH_OPERATOR_EMAIL=you@mail.ru
# In-process scheduler (default on). Set 0 to disable.
# OUTREACH_SCHEDULER=0
# Secret for POST /api/cron/outreach (defaults to ADMIN_PASSWORD)
# OUTREACH_CRON_SECRET=
# Dry-run: log only, no SMTP
# OUTREACH_MAIL_TEST=1
OUTREACH_FROM_NAME=Сергей Махнев
OUTREACH_PHONE=+7 908 644-48-21
OUTREACH_SITE_URL=https://revenshare.ru
# OUTREACH_UNSUBSCRIBE_SECRET=
