# Public site URL (used in metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3041
# Demo subdomain host only (no scheme). Local: demo.localhost → http://demo.localhost:3041/mebel39/
NEXT_PUBLIC_DEMO_HOST=demo.localhost
# Runtime override for the server (wins over the value above). Production: demo.revenshare.ru
# DEMO_HOST=demo.revenshare.ru
# Folder with separate demo git projects (default: demo-workspace)
DEMO_WORKSPACE=demo-workspace

# Secret admin URL: https://your.domain/a/<ADMIN_PATH>
# Generate: node -e "console.log('rs-'+require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PATH=
# Password on that page (min 6 chars)
ADMIN_PASSWORD=
# Optional extra secret for cookie signing (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Telegram lead notifications (optional — leads always saved to data/leads.json)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public Telegram link in footer (optional)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/
